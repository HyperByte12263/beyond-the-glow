{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C4 choropleth: % rise in DOSM's Division 13 price index by state, Aug 2016 to Aug 2026.",
  "title": {
    "text": "How much personal-care prices rose in each state, 2016 to 2026",
    "subtitle": [
      "Rise in DOSM's price index for personal care (Division 13), Aug 2016 to Aug 2026. Malaysia overall rose 19.5%;",
      "the colour bands are centred on that, so lighter states rose more slowly than the country and darker states faster.",
      "Division 13 also includes salon services, jewellery, childcare and other personal items."
    ]
  },
  "width": "container",
  "height": 400,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "data/malaysia_states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {
          "lookup": "properties.shapeName",
          "from": {
            "data": {"url": "data/state_price_rise.csv"},
            "key": "geo_name",
            "fields": ["state", "rise_pct", "index_aug2016", "index_aug2026"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.8},
      "encoding": {
        "color": {
          "field": "rise_pct",
          "type": "quantitative",
          "title": "Price rise, 2016–2026 (%). Lighter = slower than Malaysia overall (19.5%), darker = faster",
          "scale": {
            "type": "threshold",
            "domain": [16.5, 19.5, 22.5, 25.5],
            "range": ["#e3f0d3", "#a9d8b8", "#67bda8", "#2b9a8c", "#13665f"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "labelExpr": "!isFinite(datum.value) ? '' : datum.value >= 25.5 ? '25.5+' : datum.value + ''",
            "labelOverlap": false,
            "gradientLength": 300,
            "titleLimit": 600
          }
        },
        "tooltip": [
          {"field": "properties.shapeName", "type": "nominal", "title": "State"},
          {"field": "rise_pct", "type": "quantitative", "title": "Rise since Aug 2016 (%)", "format": ".1f"},
          {"field": "index_aug2016", "type": "quantitative", "title": "Index, Aug 2016", "format": ".1f"},
          {"field": "index_aug2026", "type": "quantitative", "title": "Index, Aug 2026", "format": ".1f"}
        ]
      }
    },
    {
      "description": "Leader lines from the small territories (too small to see) to their labels in the sea.",
      "data": {
        "values": [
          {"label": "Putrajaya +27.5% (highest)", "lon": 101.69, "lat": 2.93, "labelLon": 99.9, "labelLat": 2.15},
          {"label": "Kuala Lumpur +14.5%", "lon": 101.69, "lat": 3.14, "labelLon": 99.9, "labelLat": 3.55},
          {"label": "Labuan +23.5%", "lon": 115.24, "lat": 5.29, "labelLon": 114.2, "labelLat": 6.6}
        ]
      },
      "layer": [
        {
          "mark": {"type": "rule", "color": "#6e6069", "strokeWidth": 0.8},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "longitude2": {"field": "labelLon"},
            "latitude2": {"field": "labelLat"}
          }
        },
        {
          "mark": {"type": "text", "align": "right", "dx": -4, "fontWeight": 600},
          "encoding": {
            "longitude": {"field": "labelLon", "type": "quantitative"},
            "latitude": {"field": "labelLat", "type": "quantitative"},
            "text": {"field": "label"}
          }
        }
      ]
    },
    {
      "description": "Label for the state with the smallest rise.",
      "data": {"values": [{"label": "Sabah +12.6% (lowest)", "lon": 117.1, "lat": 5.35}]},
      "mark": {"type": "text", "fontWeight": 600},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}
