{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C5 indexed line chart: national price indexes (2010 = 100) for all items, personal-care products and personal grooming services.",
  "title": {
    "text": "Beauty products got cheaper compared with everything else",
    "subtitle": [
      "Price index: 2010 prices = 100.",
      "A value of 150 means prices are 50% higher."
    ]
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/price_index_national.csv",
    "format": {"parse": {"date": "date", "index": "number"}}
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": null,
      "axis": {"format": "%Y", "tickCount": 8, "grid": false}
    },
    "y": {
      "field": "index",
      "type": "quantitative",
      "title": "Price index (2010 = 100)",
      "scale": {"domain": [82, 165], "zero": false},
      "axis": {"values": [100, 120, 140, 160]}
    }
  },
  "layer": [
    {
      "description": "Baseline: 2010 prices.",
      "data": {"values": [{"index": 100}]},
      "mark": {"type": "rule", "color": "#b7adb3", "strokeDash": [2, 2]},
      "encoding": {"x": null, "y": {"field": "index", "type": "quantitative"}}
    },
    {
      "description": "Events that explain the steps in the lines. GST: 6% from 1 April 2015, zero-rated from 1 June 2018 (replaced by SST on 1 September 2018). COVID-19 movement control order: 18 March 2020. Percentages are from the monthly index values (March vs April 2015; May vs June 2018; March vs June 2020).",
      "data": {
        "values": [{"date": "2015-04-01"}, {"date": "2018-06-01"}, {"date": "2020-03-18"}],
        "format": {"parse": {"date": "date"}}
      },
      "mark": {"type": "rule", "color": "#b7adb3", "strokeDash": [4, 3]},
      "encoding": {"y": null}
    },
    {
      "data": {"values": [{"date": "2015-04-01", "y": 95.5, "label": ["GST begins, April 2015:", "beauty prices up 2.3%"]}], "format": {"parse": {"date": "date"}}},
      "mark": {"type": "text", "align": "right", "baseline": "top", "dx": -5, "fontSize": 12, "fontStyle": "italic", "color": "#261b24", "lineHeight": 15},
      "encoding": {"y": {"field": "y", "type": "quantitative"}, "text": {"field": "label"}}
    },
    {
      "data": {"values": [{"date": "2018-06-01", "y": 97.5, "label": ["GST removed, June 2018: beauty", "prices fell 4% in a month and stayed low"]}], "format": {"parse": {"date": "date"}}},
      "mark": {"type": "text", "align": "left", "baseline": "top", "dx": 5, "fontSize": 12, "fontStyle": "italic", "color": "#261b24", "lineHeight": 15},
      "encoding": {"y": {"field": "y", "type": "quantitative"}, "text": {"field": "label"}}
    },
    {
      "data": {"values": [{"date": "2020-03-18", "y": 163, "label": ["Lockdown, March 2020: overall prices", "fell, but salon prices rose 3%"]}], "format": {"parse": {"date": "date"}}},
      "mark": {"type": "text", "align": "right", "baseline": "top", "dx": -5, "fontSize": 12, "fontStyle": "italic", "color": "#261b24", "lineHeight": 15},
      "encoding": {"y": {"field": "y", "type": "quantitative"}, "text": {"field": "label"}}
    },
    {
      "mark": {"type": "line", "interpolate": "monotone"},
      "encoding": {
        "strokeWidth": {"condition": {"test": "datum.series == 'Beauty products'", "value": 3.5}, "value": 2.2},
        "color": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": ["Salon & grooming", "All items", "Beauty products"],
            "range": ["#4fa596", "#c4bcc1", "#125e54"]
          },
          "legend": null
        },
        "strokeDash": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": ["Salon & grooming", "All items", "Beauty products"],
            "range": [[6, 3], [1, 0], [1, 0]]
          },
          "legend": null
        }
      }
    },
    {
      "description": "Details on demand: a vertical guide follows the pointer and the tooltip lists all three prices for that month.",
      "transform": [{"pivot": "series", "value": "index", "groupby": ["date"]}],
      "params": [{"name": "month", "select": {"type": "point", "fields": ["date"], "nearest": true, "on": "mouseover", "clear": "mouseout"}}],
      "mark": {"type": "rule", "color": "#6e6069", "strokeWidth": 1},
      "encoding": {
        "y": null,
        "opacity": {"condition": {"param": "month", "empty": false, "value": 0.7}, "value": 0},
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Month", "format": "%B %Y"},
          {"field": "Beauty products", "type": "quantitative", "title": "Beauty products (2010 = 100)", "format": ".1f"},
          {"field": "All items", "type": "quantitative", "title": "All items", "format": ".1f"},
          {"field": "Salon & grooming", "type": "quantitative", "title": "Salon & grooming", "format": ".1f"}
        ]
      }
    },
    {
      "description": "Dots on each line at the hovered month.",
      "transform": [{"filter": {"param": "month", "empty": false}}],
      "mark": {"type": "circle", "size": 55, "opacity": 1, "stroke": "#ffffff", "strokeWidth": 1.5},
      "encoding": {"color": {"field": "series", "type": "nominal", "legend": null}}
    },
    {
      "description": "Direct labels at the end of each line instead of a legend.",
      "transform": [
        {"joinaggregate": [{"op": "max", "field": "date", "as": "last"}]},
        {"filter": "time(datum.date) == time(datum.last)"},
        {"calculate": "datum.series + ' +' + format(datum.index - 100, '.0f') + '%'", "as": "label"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 13, "fontWeight": 600},
      "encoding": {"text": {"field": "label"}}
    }
  ],
  "padding": {"right": 160}
}
