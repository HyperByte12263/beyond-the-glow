{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "C8 treemap (Vega): number of Sephora products by category, split into each category's top 5 brands and all other brands.",
  "title": {
    "text": "304 brands, and none owns the shelf",
    "subtitle": [
      "Each category is split into its brands.",
      "Area shows the number of products listed, not sales.",
      "No brand has more than 8% of any category."
    ],
    "anchor": "start",
    "font": "Gloock, Georgia, serif",
    "fontSize": 21,
    "fontWeight": "normal",
    "subtitleFont": "Figtree, system-ui, sans-serif",
    "subtitleFontSize": 14,
    "subtitleColor": "#6e6069",
    "offset": 14
  },
  "autosize": "pad",
  "height": 420,
  "signals": [
    {
      "name": "width",
      "init": "max(containerSize()[0] - 10, 300)",
      "on": [{"events": "window:resize", "update": "max(containerSize()[0] - 10, 300)"}]
    }
  ],
  "data": [
    {
      "name": "brands",
      "url": "data/treemap_brands.csv",
      "format": {"type": "csv", "parse": {"products": "number", "rank": "number"}},
      "transform": [
        {"type": "joinaggregate", "groupby": ["category"], "fields": ["products"], "ops": ["sum"], "as": ["category_total"]},
        {"type": "formula", "expr": "datum.products / datum.category_total", "as": "share"},
        {"type": "nest", "keys": ["category"], "generate": true},
        {
          "type": "treemap",
          "field": "products",
          "sort": {"field": "value", "order": "descending"},
          "round": true,
          "method": "squarify",
          "ratio": 1.4,
          "paddingInner": 2,
          "paddingOuter": 0,
          "paddingTop": 40,
          "size": [{"signal": "width"}, {"signal": "height"}]
        }
      ]
    },
    {
      "name": "category_totals",
      "source": "brands",
      "transform": [
        {"type": "filter", "expr": "datum.depth == 2"},
        {"type": "aggregate", "groupby": ["category"], "fields": ["products"], "ops": ["sum"], "as": ["total"]}
      ]
    },
    {
      "name": "categories",
      "source": "brands",
      "transform": [
        {"type": "filter", "expr": "datum.depth == 1"},
        {"type": "lookup", "from": "category_totals", "key": "category", "fields": ["key"], "values": ["total"], "as": ["total"]}
      ]
    },
    {"name": "leaves", "source": "brands", "transform": [{"type": "filter", "expr": "datum.depth == 2"}]}
  ],
  "scales": [
    {
      "name": "key",
      "type": "ordinal",
      "domain": ["Skincare: top 5 brands", "Skincare: all other brands", "Other categories: top 5 brands", "Other categories: all other brands"],
      "range": ["#9d86c9", "#ddd3ec", "#d6ccd2", "#efeaec"]
    }
  ],
  "legends": [
    {
      "fill": "key",
      "orient": "top",
      "direction": "horizontal",
      "columns": 2,
      "columnPadding": 24,
      "rowPadding": 6,
      "symbolType": "square",
      "symbolSize": 160,
      "symbolStrokeColor": "#b7adb3",
      "symbolStrokeWidth": 0.5,
      "labelFont": "Figtree, system-ui, sans-serif",
      "labelFontSize": 13,
      "labelColor": "#261b24",
      "labelLimit": 0,
      "offset": 12
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "categories"},
      "encode": {
        "enter": {"fill": {"value": "#ffffff"}, "stroke": {"value": "#ffffff"}},
        "update": {"x": {"field": "x0"}, "y": {"field": "y0"}, "x2": {"field": "x1"}, "y2": {"field": "y1"}}
      }
    },
    {
      "type": "rect",
      "from": {"data": "leaves"},
      "encode": {
        "enter": {
          "stroke": {"value": "#ffffff"},
          "strokeWidth": {"value": 1.5},
          "tooltip": {"signal": "{'Category': datum.category, 'Brand': datum.brand, 'Products': datum.products, 'Share of category': format(datum.share, '.1%')}"}
        },
        "update": {
          "x": {"field": "x0"}, "y": {"field": "y0"}, "x2": {"field": "x1"}, "y2": {"field": "y1"},
          "fill": {"signal": "datum.category == 'Skincare' ? (datum.rank == 6 ? '#ddd3ec' : '#9d86c9') : (datum.rank == 6 ? '#efeaec' : '#d6ccd2')"}
        },
        "hover": {"fill": {"signal": "datum.category == 'Skincare' ? '#7656b0' : '#b7adb3'"}}
      }
    },
    {
      "description": "Category name (line 1) in each category's header strip.",
      "type": "text",
      "from": {"data": "categories"},
      "encode": {
        "enter": {"font": {"value": "Figtree, system-ui, sans-serif"}, "fontSize": {"value": 14}, "fontWeight": {"value": 700}, "fill": {"value": "#261b24"}, "baseline": {"value": "top"}},
        "update": {
          "x": {"signal": "datum.x0 + 4"},
          "y": {"signal": "datum.y0 + 3"},
          "text": {"signal": "(datum.key == 'Other' ? 'Other categories' : datum.key)"}
        }
      }
    },
    {
      "description": "Product count (line 2) in each category's header strip.",
      "type": "text",
      "from": {"data": "categories"},
      "encode": {
        "enter": {"font": {"value": "Figtree, system-ui, sans-serif"}, "fontSize": {"value": 12}, "fill": {"value": "#6e6069"}, "baseline": {"value": "top"}},
        "update": {
          "x": {"signal": "datum.x0 + 4"},
          "y": {"signal": "datum.y0 + 20"},
          "text": {"signal": "format(datum.total, ',') + ' products'"}
        }
      }
    },
    {
      "description": "Brand name and share, drawn only when the whole name fits in the block (about 6.8 px per character at 12 px), so no name is ever cut off. Smaller blocks show their brand in the tooltip.",
      "type": "text",
      "from": {"data": "leaves"},
      "encode": {
        "enter": {"font": {"value": "Figtree, system-ui, sans-serif"}, "fontSize": {"value": 12}, "fill": {"value": "#261b24"}, "baseline": {"value": "top"}, "lineHeight": {"value": 15}},
        "update": {
          "x": {"signal": "datum.x0 + 4"},
          "y": {"signal": "datum.y0 + 4"},
          "text": {"signal": "(datum.x1 - datum.x0 - 8 >= length(datum.brand) * 6.8 && datum.y1 - datum.y0 >= 36) ? [datum.brand, format(datum.share, '.0%')] : ''"}
        }
      }
    }
  ]
}
