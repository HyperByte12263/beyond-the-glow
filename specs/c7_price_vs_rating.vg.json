{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C7 strip plot by price band, linked to a bar chart of ratings. Skincare products with 30+ reviews, grouped into six price bands. Each dot is one product (jittered sideways so dots don't hide each other); the dark line joins each band's average rating. Clicking a band highlights it and shows its rating spread in the bar chart beside it.",
  "title": {
    "text": "Paying more barely changes the rating",
    "subtitle": [
      "1,812 skincare products with 30+ reviews, by price band.",
      "Band averages differ by less than 0.2★.",
      "Click a band to compare its ratings on the right;",
      "Shift-click to add bands; double-click to clear."
    ]
  },
  "data": {
    "url": "data/skincare_products.csv",
    "format": {"parse": {"price_usd": "number", "rating": "number", "reviews": "number", "loves": "number"}}
  },
  "params": [
    {
      "name": "category",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "Moisturizers", "Treatments", "Cleansers", "Eye Care", "Masks", "Sunscreen"],
        "name": "Product type: "
      }
    }
  ],
  "transform": [
    {"filter": "datum.reviews >= 30"},
    {"filter": "category == 'All' || datum.category == category"},
    {"calculate": "datum.price_usd < 25 ? 0 : datum.price_usd < 50 ? 1 : datum.price_usd < 75 ? 2 : datum.price_usd < 100 ? 3 : datum.price_usd < 250 ? 4 : 5", "as": "band_i"},
    {"calculate": "['Under US$25', 'US$25–50', 'US$50–75', 'US$75–100', 'US$100–250', 'Over US$250'][datum.band_i]", "as": "band"},
    {"calculate": "floor(datum.rating * 4) / 4", "as": "rating_bin"},
    {"calculate": "random()", "as": "jitter"}
  ],
  "resolve": {"scale": {"color": "shared"}, "legend": {"color": "shared"}},
  "hconcat": [
    {
      "width": 700,
      "height": 340,
      "encoding": {
        "x": {
          "field": "band",
          "type": "ordinal",
          "title": "Price (US$)",
          "sort": ["Under US$25", "US$25–50", "US$50–75", "US$75–100", "US$100–250", "Over US$250"],
          "scale": {"paddingInner": 0.15},
          "axis": {"labelAngle": 0, "labelFontSize": 13, "labelColor": "#261b24", "domain": false, "ticks": false}
        },
        "y": {
          "field": "rating",
          "type": "quantitative",
          "title": "Average rating (★)",
          "scale": {"domain": [2, 5]},
          "axis": {"values": [2, 2.5, 3, 3.5, 4, 4.5, 5]}
        }
      },
      "layer": [
        {
          "description": "Each product as a dot, spread sideways inside its band (jitter). Click to pick its band.",
          "params": [{"name": "pick", "select": {"type": "point", "fields": ["band"], "on": "click"}}],
          "mark": {"type": "circle", "size": 20, "cursor": "pointer"},
          "encoding": {
            "xOffset": {"field": "jitter", "type": "quantitative", "scale": {"domain": [0, 1], "range": [-40, 40]}},
            "color": {
              "condition": {"param": "pick", "empty": false, "datum": "Products in the band you picked"},
              "datum": "One product"
            },
            "opacity": {"condition": {"param": "pick", "empty": false, "value": 0.75}, "value": 0.5},
            "tooltip": [
              {"field": "product_name", "type": "nominal", "title": "Product"},
              {"field": "brand", "type": "nominal", "title": "Brand"},
              {"field": "price_usd", "type": "quantitative", "title": "Price (US$)", "format": "$,.2f"},
              {"field": "rating", "type": "quantitative", "title": "Average rating", "format": ".2f"},
              {"field": "reviews", "type": "quantitative", "title": "Reviews", "format": ","}
            ]
          }
        },
        {
          "description": "Average rating of each band, joined by a line.",
          "transform": [{"aggregate": [{"op": "mean", "field": "rating", "as": "rating"}, {"op": "count", "as": "n"}], "groupby": ["band", "band_i"]}],
          "layer": [
            {"mark": {"type": "line", "strokeWidth": 2.5}, "encoding": {"color": {"datum": "Average rating of the band"}, "order": {"field": "band_i"}}},
            {
              "mark": {"type": "point", "filled": true, "size": 70, "stroke": "#ffffff", "strokeWidth": 1.5, "opacity": 1},
              "encoding": {
                "color": {
                  "datum": "Average rating of the band",
                  "title": null,
                  "scale": {"domain": ["One product", "Products in the band you picked", "Average rating of the band"], "range": ["#c4bcc1", "#7656b0", "#261b24"]},
                  "legend": {"orient": "top", "direction": "horizontal", "symbolType": "circle", "labelFontSize": 13, "labelLimit": 0, "columnPadding": 18, "offset": 14}
                },
                "tooltip": [
                  {"field": "band", "type": "nominal", "title": "Price band"},
                  {"field": "rating", "type": "quantitative", "title": "Average rating", "format": ".2f"},
                  {"field": "n", "type": "quantitative", "title": "Products"}
                ]
              }
            },
            {
              "mark": {"type": "text", "dy": -14, "fontSize": 13, "fontWeight": 700},
              "encoding": {"text": {"field": "rating", "type": "quantitative", "format": ".2f"}}
            }
          ]
        },
        {
          "description": "Context the dots can't show at a glance: in the over-US$250 band, 3 of 29 products (10%) average under 3.5 stars, more than in any other band (1.5–5%).",
          "transform": [{"filter": "category == 'All'"}, {"aggregate": [{"op": "count", "as": "n"}]}, {"calculate": "'Over US$250'", "as": "band"}, {"calculate": "2.42", "as": "rating"}],
          "mark": {"type": "text", "align": "right", "baseline": "top", "dx": 48, "fontSize": 12, "fontStyle": "italic", "color": "#261b24", "lineHeight": 15},
          "encoding": {"text": {"value": ["Over US$250, 1 in 10 products is rated under 3.5★:", "the highest share of any band. Pricey is no guarantee."]}}
        }
      ]
    },
    {
      "width": 220,
      "height": 340,
      "layer": [
        {
          "description": "All products (grey): share of products in each rating band, so groups of any size compare fairly.",
          "transform": [
            {"aggregate": [{"op": "count", "as": "n"}], "groupby": ["rating_bin"]},
            {"joinaggregate": [{"op": "sum", "field": "n", "as": "total"}]},
            {"calculate": "100 * datum.n / datum.total", "as": "pct"}
          ],
          "mark": {"type": "bar", "color": "#e4dce1", "cornerRadiusEnd": 2},
          "encoding": {
            "y": {
              "field": "rating_bin",
              "type": "ordinal",
              "title": "Average rating (★)",
              "sort": "descending",
              "axis": {"labelExpr": "format(datum.value, '.2f')"}
            },
            "x": {
              "field": "pct",
              "type": "quantitative",
              "title": "% of products",
              "scale": {"domain": [0, 50], "clamp": true},
              "axis": {"values": [0, 25, 50]}
            },
            "tooltip": [
              {"field": "rating_bin", "type": "quantitative", "title": "Rating band from", "format": ".2f"},
              {"field": "pct", "type": "quantitative", "title": "% of all products", "format": ".1f"}
            ]
          }
        },
        {
          "description": "Products in the picked band(s) (violet, thinner bars on top). Nothing is highlighted until the reader picks.",
          "transform": [
            {"filter": {"param": "pick", "empty": false}},
            {"aggregate": [{"op": "count", "as": "n"}], "groupby": ["rating_bin"]},
            {"joinaggregate": [{"op": "sum", "field": "n", "as": "total"}]},
            {"calculate": "100 * datum.n / datum.total", "as": "pct"}
          ],
          "mark": {"type": "bar", "color": "#7656b0", "cornerRadiusEnd": 2, "height": {"band": 0.45}},
          "encoding": {
            "y": {"field": "rating_bin", "type": "ordinal", "sort": "descending"},
            "x": {"field": "pct", "type": "quantitative"},
            "tooltip": [
              {"field": "rating_bin", "type": "quantitative", "title": "Rating band from", "format": ".2f"},
              {"field": "pct", "type": "quantitative", "title": "% of picked products", "format": ".1f"}
            ]
          }
        },
        {
          "description": "Average rating of the picked products.",
          "transform": [
            {"filter": {"param": "pick", "empty": false}},
            {"aggregate": [{"op": "mean", "field": "rating", "as": "avg"}, {"op": "count", "as": "n"}]},
            {"calculate": "['Picked: ' + datum.n + ' products', 'average ' + format(datum.avg, '.2f') + '★']", "as": "label"}
          ],
          "mark": {"type": "text", "align": "left", "x": 0, "y": -26, "fontSize": 13, "fontWeight": 600, "color": "#7656b0"},
          "encoding": {"text": {"field": "label"}}
        },
        {
          "description": "Prompt shown until a band is picked.",
          "transform": [{"aggregate": [{"op": "count", "as": "n"}]}, {"filter": "!length(data('pick_store'))"}],
          "mark": {"type": "text", "align": "left", "x": 0, "y": -26, "fontSize": 13, "color": "#6e6069"},
          "encoding": {"text": {"value": ["Grey: all products.", "Click a band to compare."]}}
        }
      ]
    }
  ],
  "spacing": 40
}
