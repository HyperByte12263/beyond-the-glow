{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C3 graduated-symbol map linked to a ranked bar chart: Malaysia's exports of beauty, make-up and skincare products (trade code 3304) by destination in 2024. Singapore alone buys 35%, so exactly proportional circles let it swamp the map; instead circles are grouped into five value classes (graduated symbols), and the bar chart beside the map gives the exact values, including buyers too far away for the map. Hovering a bar or a circle highlights the same country in both.",
  "title": {
    "text": "Who buys Malaysia's make-up and skincare",
    "subtitle": [
      "Exports in 2024: US$173 million to 187 countries.",
      "57% went to our South-East Asian neighbours."
    ]
  },
  "spacing": 24,
  "hconcat": [
    {
      "description": "Map, zoomed on South-East and East Asia, where 81% of export value goes.",
      "width": 428,
      "height": 420,
      "projection": {
        "type": "mercator",
        "fit": {"type": "Feature", "geometry": {"type": "MultiPoint", "coordinates": [[92, -11], [146, 42]]}}
      },
      "layer": [
        {"description": "Ocean.", "data": {"sphere": true}, "mark": {"type": "geoshape", "fill": "#e2eaee", "stroke": null, "clip": true}},
        {"description": "Grid lines every 10 degrees.", "data": {"graticule": {"step": [10, 10]}}, "mark": {"type": "geoshape", "filled": false, "stroke": "#d2dce1", "strokeWidth": 0.5, "clip": true}},
        {
          "description": "Land at 50m detail, so small countries such as Singapore are drawn. Malaysia slightly darker.",
          "data": {"url": "data/world-50m.json", "format": {"type": "topojson", "feature": "countries"}},
          "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.5, "clip": true},
          "encoding": {"color": {"condition": {"test": "datum.id == '458'", "value": "#cfc5cb"}, "value": "#f4f1f2"}}
        },
        {
          "description": "Circles. Hover selection buyer_map; highlight tests both this and the bar selection (buyer_bar), so the link works both ways.",
          "params": [{"name": "buyer_map", "select": {"type": "point", "fields": ["partner"], "on": "mouseover", "clear": "mouseout"}}],
          "data": {"url": "data/trade_exports_2024.csv", "format": {"parse": {"year": "number", "value_usd": "number", "share_pct": "number", "lat": "number", "lon": "number"}}},
          "transform": [
            {"filter": "isValid(datum.lat) && datum.lat !== ''"},
            {"calculate": "datum.value_usd / 1e6", "as": "value_m"},
            {"calculate": "datum.value_m < 2 ? 'Under 2' : datum.value_m < 5 ? '2–5' : datum.value_m < 10 ? '5–10' : datum.value_m < 20 ? '10–20' : '20 or more'", "as": "size_class"}
          ],
          "mark": {"type": "circle", "color": "#c08a1e", "stroke": "#8f6514", "strokeWidth": 0.9, "clip": true, "cursor": "pointer"},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "size": {
              "field": "size_class",
              "type": "ordinal",
              "title": "Exports, 2024 (US$ million)",
              "scale": {"type": "ordinal", "domain": ["Under 2", "2–5", "5–10", "10–20", "20 or more"], "range": [30, 90, 200, 380, 650]},
              "legend": {"orient": "bottom", "direction": "horizontal", "symbolFillColor": "#c08a1e", "symbolOpacity": 0.75, "symbolStrokeColor": "#8f6514", "labelFontSize": 13, "titleLimit": 400, "columnPadding": 10, "offset": 10}
            },
            "opacity": {"condition": {"test": {"and": [{"param": "buyer_map"}, {"param": "buyer_bar"}]}, "value": 0.8}, "value": 0.2},
            "strokeWidth": {"condition": {"test": {"or": [{"param": "buyer_map", "empty": false}, {"param": "buyer_bar", "empty": false}]}, "value": 2.2}, "value": 0.9},
            "order": {"field": "value_m", "sort": "ascending"},
            "tooltip": [
              {"field": "partner", "type": "nominal", "title": "Sold to"},
              {"field": "value_m", "type": "quantitative", "title": "Exports, 2024 (US$ million)", "format": ",.1f"},
              {"field": "share_pct", "type": "quantitative", "title": "Share of exports (%)", "format": ".1f"}
            ]
          }
        },
        {
          "description": "Names of the five biggest buyers, placed beside their circles; exact values are in the bars.",
          "data": {"url": "data/trade_exports_2024.csv", "format": {"parse": {"value_usd": "number", "lat": "number", "lon": "number"}}},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "text": {"field": "partner"}
          },
          "layer": [
            {"transform": [{"filter": "datum.partner == 'Singapore'"}], "mark": {"type": "text", "align": "left", "dx": 12, "dy": 10, "fontSize": 13, "fontWeight": 700}},
            {"transform": [{"filter": "datum.partner == 'Hong Kong'"}], "mark": {"type": "text", "align": "right", "dx": -12, "fontSize": 13, "fontWeight": 600}},
            {"transform": [{"filter": "datum.partner == 'Philippines'"}], "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 13, "fontWeight": 600}},
            {"transform": [{"filter": "datum.partner == 'Japan'"}], "mark": {"type": "text", "align": "right", "dx": -11, "dy": 2, "fontSize": 13, "fontWeight": 600}},
            {"transform": [{"filter": "datum.partner == 'Indonesia'"}], "mark": {"type": "text", "align": "center", "dy": 17, "fontSize": 13, "fontWeight": 600}}
          ]
        },
        {
          "description": "Context the circles cannot show: 20.2% of export value goes to 44 Muslim-majority countries (Indonesia, the UAE, Brunei and Saudi Arabia lead), markets where halal certification often decides whether a product can be sold.",
          "data": {"values": [{"lon": 93.2, "lat": 41.2, "label": ["1 in 5 export dollars goes to", "Muslim-majority countries, where", "halal certification matters"]}]},
          "mark": {"type": "text", "align": "left", "baseline": "top", "fontSize": 13, "fontStyle": "italic", "color": "#261b24", "lineHeight": 16},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "text": {"field": "label"}
          }
        },
        {
          "description": "Malaysia, where every export starts.",
          "data": {"values": [{"lat": 3.14, "lon": 101.69, "label": "Malaysia"}]},
          "encoding": {"longitude": {"field": "lon", "type": "quantitative"}, "latitude": {"field": "lat", "type": "quantitative"}},
          "layer": [
            {"mark": {"type": "point", "shape": "diamond", "size": 60, "filled": true, "color": "#261b24", "opacity": 1}},
            {"mark": {"type": "text", "align": "right", "dx": -8, "dy": -7, "fontSize": 13, "fontWeight": 700}, "encoding": {"text": {"field": "label"}}}
          ]
        }
      ]
    },
    {
      "description": "Top 10 buyers ranked, with exact values. Buyers outside the map are marked with an asterisk.",
      "title": {"text": "Top 10 buyers (US$ million)", "fontSize": 17, "subtitle": "* Too far away to show on the map", "subtitleFontSize": 13},
      "width": 130,
      "height": 300,
      "data": {"url": "data/trade_exports_2024.csv", "format": {"parse": {"value_usd": "number", "share_pct": "number", "lat": "number", "lon": "number"}}},
      "transform": [
        {"window": [{"op": "rank", "as": "rank"}], "sort": [{"field": "value_usd", "order": "descending"}]},
        {"filter": "datum.rank <= 10"},
        {"calculate": "datum.value_usd / 1e6", "as": "value_m"},
        {"calculate": "datum.lon >= 92 && datum.lon <= 146 && datum.lat >= -11 && datum.lat <= 42", "as": "on_map"},
        {"calculate": "datum.partner + (datum.on_map ? '' : ' *')", "as": "name"},
        {"calculate": "format(datum.value_m, '.0f') + (datum.rank == 1 ? ' (' + format(datum.share_pct, '.0f') + '%)' : '')", "as": "value_label"}
      ],
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "title": null,
          "sort": {"field": "value_usd", "order": "descending"},
          "axis": {"domain": false, "ticks": false, "labelLimit": 0, "labelFontSize": 13, "labelColor": "#261b24", "labelPadding": 6}
        },
        "x": {"field": "value_m", "type": "quantitative", "title": null, "axis": null, "scale": {"domain": [0, 62]}}
      },
      "layer": [
        {
          "params": [{"name": "buyer_bar", "select": {"type": "point", "fields": ["partner"], "on": "mouseover", "clear": "mouseout"}}],
          "mark": {"type": "bar", "color": "#c08a1e", "cornerRadiusEnd": 2, "height": {"band": 0.7}, "cursor": "pointer"},
          "encoding": {
            "opacity": {"condition": {"test": {"and": [{"param": "buyer_map"}, {"param": "buyer_bar"}]}, "value": 0.85}, "value": 0.25},
            "tooltip": [
              {"field": "partner", "type": "nominal", "title": "Sold to"},
              {"field": "value_m", "type": "quantitative", "title": "Exports, 2024 (US$ million)", "format": ",.1f"},
              {"field": "share_pct", "type": "quantitative", "title": "Share of exports (%)", "format": ".1f"}
            ]
          }
        },
        {
          "mark": {"type": "text", "align": "left", "dx": 4, "fontSize": 13, "color": "#261b24"},
          "encoding": {
            "text": {"field": "value_label"}
          }
        }
      ]
    }
  ]
}
